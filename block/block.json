{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lightweight-justified-gallery/gallery",
  "version": "1.0.0",
  "title": "Justified Gallery",
  "category": "media",
  "icon": "format-gallery",
  "description": "Arrange images in automatic justified rows or hand-built diptychs, triptychs, and larger rows.",
  "keywords": ["gallery", "justified", "diptych"],
  "textdomain": "lightweight-justified-gallery",
  "attributes": {
    "images": {
      "type": "array",
      "default": []
    },
    "layoutMode": {
      "type": "string",
      "default": "automatic"
    },
    "targetRowHeight": {
      "type": "number",
      "default": 260
    },
    "rowGap": {
      "type": "number",
      "default": 12
    },
    "columnGap": {
      "type": "number",
      "default": 12
    },
    "stretchLastRow": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
